func TestEncodeDaysToInt(t *testing.T) {
	tests := []struct {
		name     string
		schedule *model.Schedule
		expected int
	}{
		{
			name: "All days false",
			schedule: &model.Schedule{
				Sunday: false, Monday: false, Tuesday: false, Wednesday: false,
				Thursday: false, Friday: false, Saturday: false,
			},
			expected: 0, // 0000000
		},
		{
			name: "All days true",
			schedule: &model.Schedule{
				Sunday: true, Monday: true, Tuesday: true, Wednesday: true,
				Thursday: true, Friday: true, Saturday: true,
			},
			expected: 127, // 1111111
		},
		{
			name: "Only Monday",
			schedule: &model.Schedule{
				Sunday: false, Monday: true, Tuesday: false, Wednesday: false,
				Thursday: false, Friday: false, Saturday: false,
			},
			expected: 1, // 0000001 (Monday = bit 0)
		},
		{
			name: "Only Tuesday",
			schedule: &model.Schedule{
				Sunday: false, Monday: false, Tuesday: true, Wednesday: false,
				Thursday: false, Friday: false, Saturday: false,
			},
			expected: 2, // 0000010 (Tuesday = bit 1)
		},
		{
			name: "Only Wednesday",
			schedule: &model.Schedule{
				Sunday: false, Monday: false, Tuesday: false, Wednesday: true,
				Thursday: false, Friday: false, Saturday: false,
			},
			expected: 4, // 0000100 (Wednesday = bit 2)
		},
		{
			name: "Only Thursday",
			schedule: &model.Schedule{
				Sunday: false, Monday: false, Tuesday: false, Wednesday: false,
				Thursday: true, Friday: false, Saturday: false,
			},
			expected: 8, // 0001000 (Thursday = bit 3)
		},
		{
			name: "Only Friday",
			schedule: &model.Schedule{
				Sunday: false, Monday: false, Tuesday: false, Wednesday: false,
				Thursday: false, Friday: true, Saturday: false,
			},
			expected: 16, // 0010000 (Friday = bit 4)
		},
		{
			name: "Only Saturday",
			schedule: &model.Schedule{
				Sunday: false, Monday: false, Tuesday: false, Wednesday: false,
				Thursday: false, Friday: false, Saturday: true,
			},
			expected: 32, // 0100000 (Saturday = bit 5)
		},
		{
			name: "Only Sunday",
			schedule: &model.Schedule{
				Sunday: true, Monday: false, Tuesday: false, Wednesday: false,
				Thursday: false, Friday: false, Saturday: false,
			},
			expected: 64, // 1000000 (Sunday = bit 6)
		},
		{
			name: "Weekdays only (Monday-Friday)",
			schedule: &model.Schedule{
				Sunday: false, Monday: true, Tuesday: true, Wednesday: true,
				Thursday: true, Friday: true, Saturday: false,
			},
			expected: 31, // 0011111 (bits 0,1,2,3,4 = 1+2+4+8+16)
		},
		{
			name: "Weekend only (Saturday-Sunday)",
			schedule: &model.Schedule{
				Sunday: true, Monday: false, Tuesday: false, Wednesday: false,
				Thursday: false, Friday: false, Saturday: true,
			},
			expected: 96, // 1100000 (bits 5,6 = 32+64)
		},
		{
			name: "Mixed pattern",
			schedule: &model.Schedule{
				Sunday: true, Monday: false, Tuesday: true, Wednesday: false,
				Thursday: true, Friday: false, Saturday: true,
			},
			expected: 106, // 1101010 (bits 1,3,5,6 = 2+8+32+64)
		},
		{
			name: "Test data pattern (Mon,Tue,Wed,Fri,Sat,Sun - no Thu)",
			schedule: &model.Schedule{
				Sunday: true, Monday: true, Tuesday: true, Wednesday: true,
				Thursday: false, Friday: true, Saturday: true,
			},
			expected: 119, // 1110111 (bits 0,1,2,4,5,6 = 1+2+4+16+32+64)
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			result := encodeDaysToInt(tt.schedule)
			if result != tt.expected {
				t.Errorf("encodeDaysToInt() = %d, expected %d (binary: got %07b, want %07b)", 
					result, tt.expected, result, tt.expected)
			}
		})
	}
}

func TestDecodeDaysFromInt(t *testing.T) {
	tests := []struct {
		name     string
		days     int
		expected model.Schedule
	}{
		{
			name: "All days false (0)",
			days: 0,
			expected: model.Schedule{
				Sunday: false, Monday: false, Tuesday: false, Wednesday: false,
				Thursday: false, Friday: false, Saturday: false,
			},
		},
		{
			name: "All days true (127)",
			days: 127,
			expected: model.Schedule{
				Sunday: true, Monday: true, Tuesday: true, Wednesday: true,
				Thursday: true, Friday: true, Saturday: true,
			},
		},
		{
			name: "Only Monday (1)",
			days: 1,
			expected: model.Schedule{
				Sunday: false, Monday: true, Tuesday: false, Wednesday: false,
				Thursday: false, Friday: false, Saturday: false,
			},
		},
		{
			name: "Only Tuesday (2)",
			days: 2,
			expected: model.Schedule{
				Sunday: false, Monday: false, Tuesday: true, Wednesday: false,
				Thursday: false, Friday: false, Saturday: false,
			},
		},
		{
			name: "Only Wednesday (4)",
			days: 4,
			expected: model.Schedule{
				Sunday: false, Monday: false, Tuesday: false, Wednesday: true,
				Thursday: false, Friday: false, Saturday: false,
			},
		},
		{
			name: "Only Thursday (8)",
			days: 8,
			expected: model.Schedule{
				Sunday: false, Monday: false, Tuesday: false, Wednesday: false,
				Thursday: true, Friday: false, Saturday: false,
			},
		},
		{
			name: "Only Friday (16)",
			days: 16,
			expected: model.Schedule{
				Sunday: false, Monday: false, Tuesday: false, Wednesday: false,
				Thursday: false, Friday: true, Saturday: false,
			},
		},
		{
			name: "Only Saturday (32)",
			days: 32,
			expected: model.Schedule{
				Sunday: false, Monday: false, Tuesday: false, Wednesday: false,
				Thursday: false, Friday: false, Saturday: true,
			},
		},
		{
			name: "Only Sunday (64)",
			days: 64,
			expected: model.Schedule{
				Sunday: true, Monday: false, Tuesday: false, Wednesday: false,
				Thursday: false, Friday: false, Saturday: false,
			},
		},
		{
			name: "Weekdays only (31)",
			days: 31,
			expected: model.Schedule{
				Sunday: false, Monday: true, Tuesday: true, Wednesday: true,
				Thursday: true, Friday: true, Saturday: false,
			},
		},
		{
			name: "Weekend only (96)",
			days: 96,
			expected: model.Schedule{
				Sunday: true, Monday: false, Tuesday: false, Wednesday: false,
				Thursday: false, Friday: false, Saturday: true,
			},
		},
		{
			name: "Mixed pattern (106)",
			days: 106,
			expected: model.Schedule{
				Sunday: true, Monday: false, Tuesday: true, Wednesday: false,
				Thursday: true, Friday: false, Saturday: true,
			},
		},
		{
			name: "Test data pattern (119)",
			days: 119,
			expected: model.Schedule{
				Sunday: true, Monday: true, Tuesday: true, Wednesday: true,
				Thursday: false, Friday: true, Saturday: true,
			},
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			var schedule model.Schedule
			decodeDaysFromInt(tt.days, &schedule)
			
			if schedule.Sunday != tt.expected.Sunday ||
				schedule.Monday != tt.expected.Monday ||
				schedule.Tuesday != tt.expected.Tuesday ||
				schedule.Wednesday != tt.expected.Wednesday ||
				schedule.Thursday != tt.expected.Thursday ||
				schedule.Friday != tt.expected.Friday ||
				schedule.Saturday != tt.expected.Saturday {
				t.Errorf("decodeDaysFromInt(%d) failed:\nGot:      Sun=%v Mon=%v Tue=%v Wed=%v Thu=%v Fri=%v Sat=%v\nExpected: Sun=%v Mon=%v Tue=%v Wed=%v Thu=%v Fri=%v Sat=%v",
					tt.days,
					schedule.Sunday, schedule.Monday, schedule.Tuesday, schedule.Wednesday,
					schedule.Thursday, schedule.Friday, schedule.Saturday,
					tt.expected.Sunday, tt.expected.Monday, tt.expected.Tuesday, tt.expected.Wednesday,
					tt.expected.Thursday, tt.expected.Friday, tt.expected.Saturday,
				)
			}
		})
	}
}

func TestRoundTripEncodeDecodeConsistency(t *testing.T) {
	testCases := []model.Schedule{
		// All combinations that should be tested
		{Sunday: false, Monday: false, Tuesday: false, Wednesday: false, Thursday: false, Friday: false, Saturday: false},
		{Sunday: true, Monday: true, Tuesday: true, Wednesday: true, Thursday: true, Friday: true, Saturday: true},
		{Sunday: false, Monday: true, Tuesday: false, Wednesday: false, Thursday: false, Friday: false, Saturday: false},
		{Sunday: false, Monday: false, Tuesday: true, Wednesday: false, Thursday: false, Friday: false, Saturday: false},
		{Sunday: false, Monday: false, Tuesday: false, Wednesday: true, Thursday: false, Friday: false, Saturday: false},
		{Sunday: false, Monday: false, Tuesday: false, Wednesday: false, Thursday: true, Friday: false, Saturday: false},
		{Sunday: false, Monday: false, Tuesday: false, Wednesday: false, Thursday: false, Friday: true, Saturday: false},
		{Sunday: false, Monday: false, Tuesday: false, Wednesday: false, Thursday: false, Friday: false, Saturday: true},
		{Sunday: true, Monday: false, Tuesday: false, Wednesday: false, Thursday: false, Friday: false, Saturday: false},
		{Sunday: false, Monday: true, Tuesday: true, Wednesday: true, Thursday: true, Friday: true, Saturday: false},
		{Sunday: true, Monday: false, Tuesday: false, Wednesday: false, Thursday: false, Friday: false, Saturday: true},
		{Sunday: true, Monday: false, Tuesday: true, Wednesday: false, Thursday: true, Friday: false, Saturday: true},
		{Sunday: true, Monday: true, Tuesday: false, Wednesday: false, Thursday: false, Friday: true, Saturday: true},
		{Sunday: true, Monday: true, Tuesday: true, Wednesday: true, Thursday: false, Friday: true, Saturday: true}, // Test data pattern
	}

	for i, original := range testCases {
		t.Run(fmt.Sprintf("Case_%d", i), func(t *testing.T) {
			// Encode to int
			encoded := encodeDaysToInt(&original)
			
			// Decode back to struct
			var decoded model.Schedule
			decodeDaysFromInt(encoded, &decoded)
			
			// Compare all weekday fields
			if decoded.Sunday != original.Sunday ||
				decoded.Monday != original.Monday ||
				decoded.Tuesday != original.Tuesday ||
				decoded.Wednesday != original.Wednesday ||
				decoded.Thursday != original.Thursday ||
				decoded.Friday != original.Friday ||
				decoded.Saturday != original.Saturday {
				t.Errorf("Round-trip test case %d failed:\nOriginal: Sun=%v Mon=%v Tue=%v Wed=%v Thu=%v Fri=%v Sat=%v\nDecoded:  Sun=%v Mon=%v Tue=%v Wed=%v Thu=%v Fri=%v Sat=%v\nEncoded value: %d (binary: %07b)",
					i,
					original.Sunday, original.Monday, original.Tuesday, original.Wednesday,
					original.Thursday, original.Friday, original.Saturday,
					decoded.Sunday, decoded.Monday, decoded.Tuesday, decoded.Wednesday,
					decoded.Thursday, decoded.Friday, decoded.Saturday,
					encoded, encoded,
				)
			}
		})
	}
}

func TestBoundaryValues(t *testing.T) {
	tests := []struct {
		name        string
		days        int
		shouldPanic bool
	}{
		{
			name:        "Minimum valid value (0)",
			days:        0,
			shouldPanic: false,
		},
		{
			name:        "Maximum valid value (127)",
			days:        127,
			shouldPanic: false,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if tt.shouldPanic {
				defer func() {
					if r := recover(); r == nil {
						t.Errorf("Expected panic for days value %d, but function did not panic", tt.days)
					}
				}()
			}

			var schedule model.Schedule
			decodeDaysFromInt(tt.days, &schedule)
			
			// If we reach here and shouldn't have panicked, verify the result makes sense
			if !tt.shouldPanic {
				// Re-encode and verify it matches
				reEncoded := encodeDaysToInt(&schedule)
				if reEncoded != tt.days {
					t.Errorf("Boundary test failed: original=%d, re-encoded=%d", tt.days, reEncoded)
				}
			}
		})
	}
}

func TestBitPatternMapping(t *testing.T) {
	// Test that bit positions match the expected weekday mapping:
	// Monday=0, Tuesday=1, Wednesday=2, Thursday=3, Friday=4, Saturday=5, Sunday=6
	
	bitTests := []struct {
		bitPosition int
		setter      func(*model.Schedule)
		getter      func(*model.Schedule) bool
		dayName     string
	}{
		{0, func(s *model.Schedule) { s.Monday = true }, func(s *model.Schedule) bool { return s.Monday }, "Monday"},
		{1, func(s *model.Schedule) { s.Tuesday = true }, func(s *model.Schedule) bool { return s.Tuesday }, "Tuesday"},
		{2, func(s *model.Schedule) { s.Wednesday = true }, func(s *model.Schedule) bool { return s.Wednesday }, "Wednesday"},
		{3, func(s *model.Schedule) { s.Thursday = true }, func(s *model.Schedule) bool { return s.Thursday }, "Thursday"},
		{4, func(s *model.Schedule) { s.Friday = true }, func(s *model.Schedule) bool { return s.Friday }, "Friday"},
		{5, func(s *model.Schedule) { s.Saturday = true }, func(s *model.Schedule) bool { return s.Saturday }, "Saturday"},
		{6, func(s *model.Schedule) { s.Sunday = true }, func(s *model.Schedule) bool { return s.Sunday }, "Sunday"},
	}

	for _, tt := range bitTests {
		t.Run(tt.dayName+" bit position "+string(rune(tt.bitPosition+'0')), func(t *testing.T) {
			// Test encoding: set only this day and verify the bit is set correctly
			var schedule model.Schedule
			tt.setter(&schedule)
			
			encoded := encodeDaysToInt(&schedule)
			expectedValue := 1 << tt.bitPosition
			
			if encoded != expectedValue {
				t.Errorf("Encoding %s: got %d (binary: %07b), expected %d (binary: %07b)", 
					tt.dayName, encoded, encoded, expectedValue, expectedValue)
			}

			// Test decoding: set only this bit and verify the correct day is set
			var decoded model.Schedule
			decodeDaysFromInt(expectedValue, &decoded)
			
			if !tt.getter(&decoded) {
				t.Errorf("Decoding bit %d: %s should be true but was false", tt.bitPosition, tt.dayName)
			}
			
			// Verify all other days are false
			allDays := []struct {
				getter func(*model.Schedule) bool
				name   string
			}{
				{func(s *model.Schedule) bool { return s.Monday }, "Monday"},
				{func(s *model.Schedule) bool { return s.Tuesday }, "Tuesday"},
				{func(s *model.Schedule) bool { return s.Wednesday }, "Wednesday"},
				{func(s *model.Schedule) bool { return s.Thursday }, "Thursday"},
				{func(s *model.Schedule) bool { return s.Friday }, "Friday"},
				{func(s *model.Schedule) bool { return s.Saturday }, "Saturday"},
				{func(s *model.Schedule) bool { return s.Sunday }, "Sunday"},
			}
			
			for _, day := range allDays {
				if day.name != tt.dayName && day.getter(&decoded) {
					t.Errorf("Decoding bit %d: %s should be false but was true", tt.bitPosition, day.name)
				}
			}
		})
	}
}